# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Credenciales del contenedor de PostgreSQL (docker-compose las usa para crear la DB)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=csv_gcp
# Puerto del host mapeado al 5432 del contenedor
POSTGRES_PORT=5432

# Cadena de conexión de Prisma. Tiene que coincidir con las credenciales de arriba.
# Dentro de docker-compose (perfil app) se sobrescribe para usar el host "postgres".
DATABASE_URL=postgresql://app:app@localhost:5432/csv_gcp?schema=public
