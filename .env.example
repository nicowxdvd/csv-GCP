# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Credenciales del contenedor de PostgreSQL (docker-compose las usa para crear la DB)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=csv_gcp
# Puerto del host mapeado al 5432 del contenedor
POSTGRES_PORT=5432

# Cadena de conexión de Prisma. Tiene que coincidir con las credenciales de arriba.
# Dentro de docker-compose (perfil app) se sobrescribe para usar el host "postgres".
DATABASE_URL=postgresql://app:app@localhost:5432/csv_gcp?schema=public


dotenv
# NODE_ENV = comportamiento de Node/librerías. APP_ENV = qué recursos GCP y datos usa el proceso.
NODE_ENV=development
APP_ENV=development
# api | worker | all ("all" solo en dev)
APP_ROLE=all
PORT=3000
LOG_LEVEL=debug

# Contenedor PostgreSQL (docker-compose lo usa para crear la DB)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=csv_gcp
POSTGRES_PORT=5432
# SPEC-04 cambia este usuario por csv_app (solo CRUD)
DATABASE_URL=postgresql://app:app@localhost:5432/csv_gcp?schema=public

REDIS_URL=redis://localhost:6379

GCP_PROJECT_ID=csv-gcp-dev
GCS_STAGING_BUCKET=dev-local-csv-staging
GCS_OUTPUT_BUCKET=dev-local-csv-output
# Los SDK de GCP leen estas dos directo de process.env; en producción deben no existir
STORAGE_EMULATOR_HOST=http://localhost:4443
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC_BATCH_UPLOADED=csv-batch-uploaded
PUBSUB_TOPIC_BATCH_NORMALIZED=csv-batch-normalized
PUBSUB_TOPIC_BATCH_COMPLETED=csv-batch-completed
PUBSUB_TOPIC_DEAD_LETTER=csv-batch-dlq
# Solo producción (worker): audience y SA que firma el token OIDC del push
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SA_EMAIL=

# dev-secret = tokens locales para Postman. jwks = IdP real (pendiente de definir con el front)
AUTH_MODE=dev-secret
AUTH_DEV_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Orígenes del front separados por coma
CORS_ORIGINS=http://localhost:4200
CURSOR_SECRET=reemplazar-por-otro-secreto-aleatorio-de-al-menos-32-caracteres

UPLOAD_MAX_BYTES=26214400
MAX_CSV_ROWS=100000
MAX_INVALID_ROW_RATIO=0.2
SIGNED_URL_TTL_SECONDS=900